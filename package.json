{
  "name": "lhh-fire-watch-binder",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "binderpress setup:private",
    "setup:private": "binderpress setup:private",
    "build": "binderpress build",
    "build:public": "binderpress build --public",
    "build:private": "binderpress build --private",
    "check": "binderpress check",
    "lint:layout": "binderpress lint:layout",
    "preview": "binderpress preview",
    "editor": "binderpress editor",
    "editor:private": "binderpress editor --private",
    "editor:public": "binderpress editor --public",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "binderpress": "https://codeload.github.com/BoondockMark/BinderPress/tar.gz/048c82db8ce9d2c132a13266b2a01803cba4f6a7"
  },
  "allowScripts": {
    "puppeteer@25.12.0": true
  }
}
