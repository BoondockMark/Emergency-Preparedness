{
  "name": "lhh-fire-watch-binder",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:public": "node scripts/build.mjs --public",
    "build:private": "node scripts/build.mjs --private",
    "check": "node scripts/build.mjs --check",
    "lint:layout": "node scripts/lint-layout.mjs",
    "test:visual:update": "node scripts/build.mjs --update-visuals",
    "preview": "node scripts/preview.mjs",
    "editor": "node scripts/editor.mjs",
    "editor:private": "node scripts/editor.mjs --private",
    "editor:public": "node scripts/editor.mjs --public",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "puppeteer": "^25.12.0"
  },
  "allowScripts": {
    "puppeteer@25.12.0": true
  }
}
